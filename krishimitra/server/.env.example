# Backend configuration. Copy to server/.env for local use; in production set these in the Render dashboard.
# NEVER commit the real .env file or paste real values into this example file.

# --- Gemini (optional: without a key the app runs in labelled AI demo mode) ---
GEMINI_API_KEY=
# REQUIRED when GEMINI_API_KEY is set. There is deliberately no default: Google retires/restricts models over
# time (e.g. gemini-2.5-flash is limited to accounts that already used it). Pick a current Flash-class model from
# https://ai.google.dev/gemini-api/docs/models and verify with GET /api/health?deep=true (ai.check must be "ok").
GEMINI_MODEL=

# --- Mandi prices (optional: without these, live prices show "unavailable" and sample data is offered separately) ---
# Currently supported provider: a data.gov.in AGMARKNET-style resource (full resource URL, JSON, `records` array).
MANDI_API_BASE_URL=
MANDI_API_KEY=
# The data.gov.in records carry no unit. Only set this if YOU have verified the dataset's unit (e.g. Rs/Quintal).
MANDI_DEFAULT_UNIT=
# Prices older than this many days are flagged as old.
MANDI_STALE_DAYS=3

# --- Web / CORS ---
# The exact origin of the deployed frontend, WITHOUT a path or trailing slash. Several origins: comma-separated.
# Local development: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Misc ---
APP_ENV=development
# Reserved; the app currently stores nothing in a database.
DATABASE_URL=sqlite:///./krishimitra.db
