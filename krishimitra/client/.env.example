# client (Vite). Copy to .env.local for local overrides, or set in the Vercel dashboard for production.
# Only variables starting with VITE_ are exposed to the browser, so NEVER put secrets here.
#
# Leave EMPTY for local development: the Vite dev server proxies /api to http://localhost:8000.
# For production (Vercel) set it to your public server URL, with no trailing slash, e.g.
#   VITE_API_BASE_URL=https://your-server.onrender.com
# This value is baked in at BUILD time: change it, then redeploy the client.
VITE_API_BASE_URL=http://localhost:8000
